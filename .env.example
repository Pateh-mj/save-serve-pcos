# ─── Database (Supabase → Project Settings → Database → Connection string) ───
# Pooled (Transaction pooler, port 6543) for the running app. Never use the session pooler (5432) here:
# it allows only ~15 clients in total and serverless instances exhaust it. On Vercel use connection_limit=1; pool_timeout=30 lets busy pages wait for a connection instead of failing.
DATABASE_URL="postgresql://postgres.<project>:<password>@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=30"
# Direct / session (port 5432) for prisma db push
DIRECT_URL="postgresql://postgres.<project>:<password>@aws-1-eu-west-2.pooler.supabase.com:5432/postgres"

# ─── Auth ─── generate with: npx auth secret   (required in production)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── SMS ───────────────────────────────────────────────────────────────────
# log = record messages without sending (safe default) · http = send via the provider below
SMS_DRIVER="log"
SMS_SENDER_ID="SaveServe"
# Only these numbers receive real SMS while set (protects credits during demos). Comma-separated.
SMS_ALLOWLIST=""
SMS_DAILY_LIMIT_PER_NUMBER="10"

# Generic HTTP bulk-SMS provider. Placeholders: {to} {message} {sender}
# Example GET-style API:
#   SMS_HTTP_METHOD="GET"
#   SMS_HTTP_URL="https://provider.example/api/send?key=YOUR_KEY&to={to}&from={sender}&msg={message}"
# Example JSON POST API:
#   SMS_HTTP_METHOD="POST"
#   SMS_HTTP_URL="https://provider.example/api/v1/sms"
#   SMS_HTTP_HEADERS='{"Authorization":"Bearer YOUR_KEY"}'
#   SMS_HTTP_CONTENT_TYPE="application/json"
#   SMS_HTTP_BODY='{"to":"{to}","message":"{message}","sender":"{sender}"}'
SMS_HTTP_METHOD="POST"
SMS_HTTP_URL=""
SMS_HTTP_HEADERS=""
SMS_HTTP_CONTENT_TYPE="application/json"
SMS_HTTP_BODY=""
# Optional: text/regex the provider's response must contain to count as sent
SMS_HTTP_SUCCESS=""
# Optional: dot-path to the message id in a JSON response (enables delivery reports)
SMS_HTTP_ID_FIELD=""
# e164 (+260971234567) | intl (260971234567) | local (0971234567)
SMS_PHONE_FORMAT="intl"
# Delivery reports: point the provider at https://<host>/api/sms/status?token=<this>
SMS_CALLBACK_TOKEN=""

# ─── Scheduled reminders (Vercel Cron sends this as a Bearer token) ──────────
CRON_SECRET=""

# Show one-click demo sign-in buttons on /login (presentations only)
# NEXT_PUBLIC_DEMO_LOGINS=1
