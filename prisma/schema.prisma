generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth (NextAuth required tables) ─────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core User ────────────────────────────────────────────────────────────────
// role:  PATIENT | PRACTITIONER | NGO | ADMIN
// tier:  FREE | BASIC | PREMIUM

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  phone         String?   @unique
  password      String?
  role          String    @default("PATIENT")
  tier          String    @default("FREE")
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  patient      Patient?
  practitioner Practitioner?
  ngo          NGO?
}

// ─── Patient ──────────────────────────────────────────────────────────────────

model Patient {
  id               String    @id @default(cuid())
  userId           String    @unique
  nrc              String?
  dateOfBirth      DateTime?
  address          String?
  emergencyContact String?
  createdAt        DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  ehrRecords   EHRRecord[]
  billings     Billing[]
}

// ─── Practitioner ─────────────────────────────────────────────────────────────
// specialty: NURSE | PHARMACIST | PHYSIOTHERAPIST

model Practitioner {
  id         String   @id @default(cuid())
  userId     String   @unique
  specialty  String
  licenseNo  String   @unique
  location   String?
  bio        String?
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  ehrRecords   EHRRecord[]
  availability Availability[]
}

// ─── Appointment ──────────────────────────────────────────────────────────────
// status:  PENDING | CONFIRMED | COMPLETED | CANCELLED
// channel: WEB | USSD

model Appointment {
  id             String   @id @default(cuid())
  patientId      String
  practitionerId String
  scheduledAt    DateTime
  status         String   @default("PENDING")
  channel        String   @default("WEB")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  billing      Billing?
  ehrRecord    EHRRecord?
}

// ─── EHR ──────────────────────────────────────────────────────────────────────

model EHRRecord {
  id             String   @id @default(cuid())
  patientId      String
  practitionerId String
  appointmentId  String?  @unique
  visitDate      DateTime @default(now())
  diagnosis      String?
  prescription   String?
  notes          String?
  createdAt      DateTime @default(now())

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
}

// ─── Billing + Policy Guardian ───────────────────────────────────────────────
// tier:   FREE | BASIC | PREMIUM
// status: PENDING | PAID | SUBSIDIZED | WAIVED

model Billing {
  id               String   @id @default(cuid())
  appointmentId    String   @unique
  patientId        String
  amount           Float
  discountedAmount Float?
  tier             String
  subsidyApplied   Boolean  @default(false)
  subsidyAmount    Float?
  status           String   @default("PENDING")
  policyId         String?
  createdAt        DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  policy      Policy?     @relation(fields: [policyId], references: [id])
}

model Policy {
  id                String   @id @default(cuid())
  name              String
  tier              String
  billingMultiplier Float    @default(1.0)
  rules             String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  billings Billing[]
}

// ─── NGO ──────────────────────────────────────────────────────────────────────

model NGO {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  fundBalance Float    @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── USSD Session ─────────────────────────────────────────────────────────────

model USSDSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  phone     String
  state     String   @default("MAIN_MENU")
  data      String   @default("{}")
  expiresAt DateTime
  createdAt DateTime @default(now())
}


model Availability {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  dayOfWeek      Int          // 0 = Sunday ... 6 = Saturday
  startTime      String       // "09:00"
  endTime        String       // "17:00"
  isActive       Boolean      @default(false)

  @@unique([practitionerId, dayOfWeek])
  @@map("availabilities")
}