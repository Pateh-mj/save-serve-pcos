generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth (NextAuth required tables) ─────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core User ────────────────────────────────────────────────────────────────
// role:  PATIENT | PRACTITIONER | NGO | ADMIN
// tier:  FREE | BASIC | PREMIUM

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  phone         String?   @unique
  password      String?
  role          String    @default("PATIENT")
  tier          String    @default("FREE")
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  patient      Patient?
  practitioner Practitioner?
  ngo          NGO?
}

// ─── Patient ──────────────────────────────────────────────────────────────────

model Patient {
  id               String    @id @default(cuid())
  userId           String    @unique
  nrc              String?
  dateOfBirth      DateTime?
  address          String?
  emergencyContact String?
  createdAt        DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  ehrRecords   EHRRecord[]
  billings     Billing[]
  feedback     Feedback[]
}

// ─── Practitioner ─────────────────────────────────────────────────────────────
// specialty: NURSE | PHARMACIST | PHYSIOTHERAPIST

model Practitioner {
  id         String   @id @default(cuid())
  userId     String   @unique
  specialty  String
  licenseNo  String   @unique
  location   String?
  bio        String?
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  ehrRecords   EHRRecord[]
  availability Availability[]
}

// ─── Appointment ──────────────────────────────────────────────────────────────
// status:  PENDING | CONFIRMED | COMPLETED | CANCELLED
// channel: WEB | USSD
// triageLevel: ROUTINE | URGENT | EMERGENCY (see lib/triage.ts)

model Appointment {
  id             String    @id @default(cuid())
  patientId      String
  practitionerId String
  scheduledAt    DateTime
  status         String    @default("PENDING")
  channel        String    @default("WEB")
  notes          String?
  triageLevel    String    @default("ROUTINE")
  triageScore    Int       @default(0)
  symptoms       String    @default("") // comma-separated symptom codes
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  billing      Billing?
  ehrRecord    EHRRecord?
  feedback     Feedback?
  smsMessages  SmsMessage[]
}

// ─── EHR ──────────────────────────────────────────────────────────────────────

model EHRRecord {
  id                     String    @id @default(cuid())
  patientId              String
  practitionerId         String
  appointmentId          String?   @unique
  visitDate              DateTime  @default(now())
  diagnosis              String?
  prescription           String?
  notes                  String?
  followUpDate           DateTime?
  followUpReminderSentAt DateTime?
  createdAt              DateTime  @default(now())

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
}

// ─── Billing + Policy Guardian ───────────────────────────────────────────────
// tier:   FREE | BASIC | PREMIUM
// status: PENDING | PAID | SUBSIDIZED | WAIVED

model Billing {
  id               String   @id @default(cuid())
  appointmentId    String   @unique
  patientId        String
  amount           Float
  discountedAmount Float?
  tier             String
  subsidyApplied   Boolean  @default(false)
  subsidyAmount    Float?
  status           String   @default("PENDING")
  policyId         String?
  // NGO pool that funded this visit (FREE tier) or receives its surplus (PREMIUM tier)
  ngoId            String?
  createdAt        DateTime @default(now())

  appointment      Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  policy           Policy?           @relation(fields: [policyId], references: [id])
  ngo              NGO?              @relation(fields: [ngoId], references: [id])
  fundTransactions FundTransaction[]
}

model Policy {
  id                String   @id @default(cuid())
  name              String
  tier              String
  billingMultiplier Float    @default(1.0)
  rules             String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  billings Billing[]
}

// ─── NGO ──────────────────────────────────────────────────────────────────────

model NGO {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  fundBalance Float    @default(0)
  createdAt   DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  billings         Billing[]
  fundTransactions FundTransaction[]
}

// ─── NGO fund ledger ──────────────────────────────────────────────────────────
// Every movement of pool money, so fundBalance can be reconciled (lib/ledger.ts).
// type:   OPENING | TOPUP | SUBSIDY_DEBIT | SUBSIDY_REFUND | PREMIUM_CREDIT
// amount: signed — positive credits the pool, negative debits it

model FundTransaction {
  id        String   @id @default(cuid())
  ngoId     String
  type      String
  amount    Float
  billingId String?
  note      String?
  createdAt DateTime @default(now())

  ngo     NGO      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  billing Billing? @relation(fields: [billingId], references: [id], onDelete: SetNull)

  @@index([ngoId, createdAt])
}

// ─── USSD Session ─────────────────────────────────────────────────────────────
// state: the effective menu path; an incomplete booking path can be resumed on redial

model USSDSession {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  phone          String
  state          String   @default("MAIN_MENU")
  data           String   @default("{}")
  completed      Boolean  @default(false)
  expiresAt      DateTime
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([phone, lastActivityAt])
}

// ─── SMS ──────────────────────────────────────────────────────────────────────
// status: QUEUED | SENT | DELIVERED | FAILED | SKIPPED

model SmsMessage {
  id                String   @id @default(cuid())
  to                String
  body              String
  purpose           String
  status            String   @default("QUEUED")
  driver            String
  providerMessageId String?
  error             String?
  segments          Int      @default(1)
  appointmentId     String?
  userId            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([to, createdAt])
  @@index([providerMessageId])
}

// ─── Patient satisfaction ─────────────────────────────────────────────────────

model Feedback {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  patientId     String
  rating        Int // 1–5
  comment       String?
  channel       String // WEB | USSD
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// ─── Admin-editable settings (e.g. consultationFee) ──────────────────────────

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Evaluation instrumentation (objective 4: response time) ─────────────────

model RequestMetric {
  id         String   @id @default(cuid())
  channel    String // USSD | WEB | SMS
  action     String
  durationMs Int
  ok         Boolean
  createdAt  DateTime @default(now())

  @@index([channel, createdAt])
}

model Availability {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  dayOfWeek      Int
  startTime      String
  endTime        String
  isActive       Boolean      @default(false)

  @@unique([practitionerId, dayOfWeek])
}
